<a href="/jobs/<%=@job.id%>">&laquo; Back to Job Post</a>

<h1>Edit this Job:</h1>
<form action="<%="/jobs/#{@job.id}"%>" method="POST">
    <input id="hidden" type="hidden" name="_method" value="PATCH">
    <label for="title">Job Title: </label>
    <input type="text" name="title" id="title" value="<%=@job.title%>">
    <br>
    <label for="location">Location: </label>
    <input type="text" name="location" id="location" value="<%=@job.location%>">
    <br>
    <label for="description">Description: </label>
    <textarea id="description" name="description" rows="5" cols="80"><%=@job.description%></textarea>
    <br>
    <label for="company_id">Choose an Existing Company: </label>
    <select name="company_id">
        <option disabled selected value="<%=@job.company.id%>"><%=@job.company.name%></option>
        <%@companies.each do |company| %>
            <option value="<%=company.id%>"><%=company.name%></option>
        <%end%>
    </select>
    <label for="new_company">or Enter your Company's Name:</label>
    <input type="text" name="new_company" id="new_company">
    <input type="submit" value="Submit">
</form>

<form action="/jobs" method="get">
    <input type="submit" value="Cancel Edit">
</form>