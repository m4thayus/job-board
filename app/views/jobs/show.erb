<a href="/jobs">&laquo; Back to Job Listings</a>

<h1><%=@job.title%></h1>

<h2><%=@job.company.name%> | <%=@job.location%></h2>
<a href="/companies/<%= @job.company.id %>">See all Jobs at <%= @job.company.name %></a>

<%=@job.description%>

<div class="form-container">
    <form action="/jobs/<%=@job.id%>/edit" method="get">
        <input type="submit" value="Edit This Job">
    </form>

    <form action="/jobs/<%=@job.id%>" method="POST">
        <input id="hidden" type="hidden" name="_method" value="DELETE">
        <input type="submit" value="Delete This Job">
    </form>
</div>