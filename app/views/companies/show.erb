<style>
    label {display: block;}
    input, textarea, select {margin-bottom: 1em;}
    form {display: inline-block;}
    .form-container {
        display: block; 
        margin-top: 1em;
        }
</style>

<a href="/companies">&laquo; Back to Companies</a>

<h1><%=@company.name%></h1>

<% @company.jobs.each_with_index do |job, i| %>
    <hr>
    <h2><%="#{i + 1}. "%><a href="/jobs/<%=job.id%>"><%= job.title %></a></h2>
    <h3><%= job.location %></h3>
    <%=job.description.split.slice(0, 50).join(' ').concat("...")%>
<% end %>

<div class="form-container">
    <form action="/companies/<%=@company.id%>/edit" method="get">
        <input type="submit" value="Edit Your Company">
    </form>

    <form action="/companies/<%=@company.id%>" method="POST">
        <input id="hidden" type="hidden" name="_method" value="DELETE">
        <input type="submit" value="Delete Your Company">
    </form>
</div>